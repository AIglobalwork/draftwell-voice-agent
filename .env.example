# Copy to .env and fill in. Never commit .env.

# LiveKit Cloud project
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google AI Studio key (free tier). Used only for text conversation tests.
GOOGLE_API_KEY=

# Voice model (LiveKit Inference) and text model for conversation tests
VOICE_MODEL=google/gemini-3.8-live
TEST_LLM_MODEL=gemini-3.5-flash-lite

# Who runs the voice model: livekit (default when empty: LiveKit Inference, uses VOICE_MODEL)
# or google (the Gemini API directly, model gemini-3.8-live, key below).
VOICE_PROVIDER=
# Gemini API key for VOICE_PROVIDER=google. Create it in a separate AI Studio project with no
# billing (Free tier), so the worst case stays $0. Not the GOOGLE_API_KEY above.
GOOGLE_VOICE_API_KEY=

# Google Calendar (service account JSON is passed as one env value, never a file)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Owner email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OWNER_EMAIL=

# Owner Slack notifications
SLACK_WEBHOOK_URL=

# SMS (code exists but is off)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE=
